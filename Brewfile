# Declarative dependency list. Install everything with:
#
#     brew bundle --file=Brewfile
#
# setup.sh does this for you. To add a tool, add a line here and re-run setup.sh.

# Shell experience
brew "zsh-syntax-highlighting" # Colours commands, paths and errors as you type
brew "zsh-autosuggestions"     # Suggests commands from history ahead of the cursor
brew "fzf"                     # Fuzzy finder: Ctrl-R history, Ctrl-T files, Alt-C cd

# Version control
brew "git" # macOS ships an Apple build that lags upstream
